# ==========================================
# ENVIRONMENT VARIABLES AND SECRETS
# ==========================================

.env
.env.*
!.env.example
!.env.sample

# Explicitly ignore backend and frontend secrets
backend/.env
backend/.env.*
!backend/.env.example

frontend/.env
frontend/.env.*
!frontend/.env.example

# ==========================================
# NODE.JS DEPENDENCIES
# ==========================================

node_modules/
backend/node_modules/
frontend/node_modules/

# ==========================================
# BUILD OUTPUT
# ==========================================

dist/
dist-ssr/
build/
coverage/
.vite/

# ==========================================
# LOG FILES
# ==========================================

npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# ==========================================
# OPERATING SYSTEM FILES
# ==========================================

.DS_Store
Thumbs.db
desktop.ini

# ==========================================
# EDITOR AND IDE FILES
# ==========================================

.vscode/
!.vscode/extensions.json
.idea/

# ==========================================
# LOCAL CONFIGURATION
# ==========================================

*.local